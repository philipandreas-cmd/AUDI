      "source": [
        "# different flattening strategy compared to the first version -- picking 6 brands for training only and leaving 2 brands for validation\n",
        "# trying to avoid brand memorization or data leak\n",
        "# then we will see what happens with the results after the change\n",
        "\n",
        "import os, shutil\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "RAW_DIR   = \"data/Straw Defects in Juice Box\"\n",
        "CLEAN_DIR = \"data_clean_brandsplit\"\n",
        "CLASSES   = [\"Good\", \"Bent\", \"Missing\", \"Loose\", \"Pierced\"]\n",
        "\n",
        "# 6 brands for training\n",
        "TRAIN_BRANDS = [\"Choco\", \"Chocolait\", \"Nutriboost\", \"Chuckie\", \"Moo\", \"Selecta\"]\n",
        "# 2 brands for validation\n",
        "VAL_BRANDS   = [\"Dutchmill Purple\", \"Dutchmill Yellow\"]\n",
        "\n",
        "for split in [\"train\", \"val\"]:\n",
        "    for cls in CLASSES:\n",
        "        os.makedirs(os.path.join(CLEAN_DIR, split, cls), exist_ok=True)\n",
        "\n",
        "for cls in CLASSES:\n",
        "    train_imgs, val_imgs = [], []\n",
        "    for brand in os.listdir(RAW_DIR):\n",
        "        cls_path = os.path.join(RAW_DIR, brand, cls)\n",
        "        if not os.path.isdir(cls_path):\n",
        "            continue\n",
        "        imgs = [os.path.join(cls_path, f) for f in os.listdir(cls_path)\n",
        "                if f.lower().endswith((\".jpg\", \".jpeg\", \".png\"))]\n",
        "        if brand in TRAIN_BRANDS:\n",
        "            train_imgs += imgs\n",
        "        elif brand in VAL_BRANDS:\n",
        "            val_imgs += imgs\n",
        "\n",
        "    for i, src in enumerate(train_imgs):\n",
        "        shutil.copy(src, os.path.join(CLEAN_DIR, \"train\", cls, f\"{cls}_{i}.jpg\"))\n",
        "    for i, src in enumerate(val_imgs):\n",
        "        shutil.copy(src, os.path.join(CLEAN_DIR, \"val\", cls, f\"{cls}_{i}.jpg\"))\n",
        "\n",
        "    print(f\"{cls}: {len(train_imgs)} train, {len(val_imgs)} val\")"
