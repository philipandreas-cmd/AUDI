        "# loading the data with augmentation\n",
        "\n",
        "train_tf = transforms.Compose([\n",
        "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
        "    # resize images to the same size\n",
        "\n",
        "    transforms.RandomHorizontalFlip(),\n",
        "    # randomly flip images horizontally to create variation\n",
        "\n",
        "    transforms.RandomRotation(15),\n",
        "    # rotate images so the model becomes more robust\n",
        "\n",
        "    transforms.ColorJitter(brightness=0.2, contrast=0.2),\n",
        "    # change brightness and contrast (trying to make model work/recognize state under different light)\n",
        "\n",
        "    transforms.ToTensor(),\n",
        "    # convert image to tensor (required for PyTorch)\n",
        "\n",
        "    transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])\n",
        "    # normalize using ImageNet values\n",
        "])\n",
        "\n",
        "val_tf = transforms.Compose([\n",
        "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
        "    # resize images\n",
        "    transforms.ToTensor(),\n",
        "    # convert to tensor\n",
        "    transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225])\n",
        "    # normalize (same values as for the training)\n",
        "])\n",
        "# NOTE: no augmentation here because validation should reflect real data not synthetic ones\n",
