        "# importing and using EfficientNet-B0 model\n",
        "\n",
        "from torchvision.models import efficientnet_b0, EfficientNet_B0_Weights\n",
        "\n",
        "NUM_CLASSES = len(train_ds.classes)\n",
        "# number of output classes -> based on dataset\n",
        "\n",
        "model = efficientnet_b0(weights=EfficientNet_B0_Weights.DEFAULT)\n",
        "# load pretrained EfficientNet-B0 (already trained on ImageNet)\n",
        "\n",
        "# !!! Freeze feature extractor (train only classifier first)\n",
        "for param in model.features.parameters():\n",
        "    param.requires_grad = False\n",
        "\n",
        "model.classifier[1] = nn.Linear(model.classifier[1].in_features, NUM_CLASSES)\n",
        "# Replace classifier head for our number of classes\n",
        "# change final layer so it predicts our classes instead of ImageNet\n",
        "\n",
        "model = model.to(DEVICE)\n",
        "\n",
        "# loss function for classification\n",
